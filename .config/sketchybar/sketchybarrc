# A simple sketchybar config for aerospace users to get started with
# Not too different from the base starting config!

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items" 

source "$CONFIG_DIR/colors.sh"
# $CONFIG_DIR/sketchybar.py

sketchybar --bar position=top height=30 radius=30 color=$BAR_COLOR


default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="SF Pro:Semibold:14.0"
  # icon.color=$ICON_COLOR
  icon.color=0xffa6adc8
  # label.color=$LABEL_COLOR
  label.color=0xffa6adc8
  icon.padding_left=0
  icon.padding_right=0
  label.padding_left=0
  label.padding_right=0
  background.padding_left=2
  background.padding_right=2
  updates=on
)
sketchybar --default "${default[@]}"

##### Adding aeropsace layouts #####

# Add the aerospace_workspace_change event we specified in aerospace.toml
# sketchybar --add event aerospace_workspace_change  
sketchybar --add event aerospace_window_focus_change
# sketchybar --add event aerospace
sketchybar --add event aerospace_fullscreen


sketchybar --add item controller left \
               --set controller label='contr' \
               --subscribe controller  aerospace_window_focus_change  \
               --set controller drawing=off \
               --set controller script="python3 $CONFIG_DIR/plugins/custom/aerospace.py"

aerospace list-monitors --format "%{monitor-id} %{monitor-appkit-nsscreen-screens-id}" | while read -r aero_monitor sb_monitor; do
for sid in $(aerospace list-workspaces --monitor $aero_monitor); do
    echo $sid $aero_monitor $sb_monitor

    sketchybar --add item space.$sid left \
      --set space.$sid display="$sb_monitor" \
      --set space.$sid \
      drawing=on \
      background.corner_radius=8 \
      background.drawing=on \
      background.height=25 \
      icon="$sid:" \
      icon.padding_left=10 \
      icon.padding_rigth=10 \
      label.font="sketchybar-app-font:Regular:12.0" \
      label.padding_right=10 \
      label.padding_left=5 \
      label.y_offset=-1 \
      label.shadow.drawing=off \
      label.shadow.color=0xA0000000 \
      label.shadow.distance=4 \
      click_script="aerospace workspace $sid"
  done
done


sketchybar --add item title left \
               --subscribe title  aerospace_fullscreen \
               --set title label='' \
               --set title script="python3 $CONFIG_DIR/plugins/custom/aerospace.py" \
               icon.font="sketchybar-app-font:Regular:12.0" \
               icon.padding_left=10 \
               icon.padding_rigth=10 \
               label.padding_right=20 \
               background.corner_radius=8 \
               drawing=on \

python3 $CONFIG_DIR/plugins/custom/windows.py


#front app
# source "$ITEM_DIR/front_app.sh"


##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other gititems respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add alias "Control Centre,Clock" right \
           --add alias "Control Centre,Battery" right \
           --add alias "Control Centre,WiFi" right \
           --add alias "Control Centre,AudioVideoModule" right
